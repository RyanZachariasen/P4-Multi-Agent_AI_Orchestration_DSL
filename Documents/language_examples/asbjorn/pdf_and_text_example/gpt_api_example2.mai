------------------ 2. Example  ------------------

// Defining agents

Agent GPT = {
    provider: openai,
    model: "gpt-4o-mini",
    api_key: (OPENAI_API_KEY)
    
    task: Summarizer {
        system_prompt: "You are an assistant for summarizing documents and text. When you summarize make it concise and easily understandable.",
        max_tokens: 10000,
    },

    task: KeyPointsHighlighter {
        system_prompt: "You are an assistant for extracting and highlighting the key and most important parts of a text or document",
        temperature: 0.3
    }

}


// Defining functions

func summarize_text (Text user_prompt, Text text) -> text:

func highlight_key_points (Text user_prompt, Text text) -> text


// extract is a keyword .text means extract as text .pdf means extract from a pdf

Workflow:
    doc = extract.text.pdf (Doc pdf)
    summary = summarize_text ("Summarize this text in 50 words or less", doc)
    key_points = highlight_key_points ("Highlight and bulletize the key and most important parts of this text", doc)

