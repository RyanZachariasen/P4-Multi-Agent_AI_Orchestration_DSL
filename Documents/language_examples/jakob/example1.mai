Agent coder = Anthropic(
    model="claude-sonnet-4-6", 
    api_key=API_KEY_NAME,
    system="You are a helpful assistant that can write code. You will be given a prompt and you should write code to solve the problem. "
    )

Agent code_reviewer = Anthropic(
    model="claude-haiku-4-5-20251001", 
    api_key=API_KEY_NAME,
    system=You are a helpful assistant that can review code. You will be given a prompt and some code. You should review the code and provide feedback on how to improve it
    )

func claude_code(Text text) -> Code:
    return claude1.prompt(text, maxtokens=10000)

func claude_review(Code code) -> Text:
    return claude2.prompt(text, maxtokens=10000)

func claude_improve(Code code, Text text) -> Code:
    return claude1.prompt(code + text, maxtokens=10000)

start:
    code = claude_code(input[1])
    review = claude_review(code)
    improved_code = claude_review(code, review)
    
    @write_file("./code.py", improved_code) 
    