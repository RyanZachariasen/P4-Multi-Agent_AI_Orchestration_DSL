# --- RESOURCES ---
Resource paper = File("/Users/.../not_even_funny.pdf")

# --- AGENTS ---
@agent(gpt-4o-mini) summarise_agent { role: "PhD researcher" }

# --- TASKS ---
@task(summarise_agent) Summarise(input: Text) {
    objective: "Summarize this text in three bullet points"
}

# --- EXECUTION ---
run:
    content = paper.read_pdf()
    result  = Summarise(content)
    print(result)