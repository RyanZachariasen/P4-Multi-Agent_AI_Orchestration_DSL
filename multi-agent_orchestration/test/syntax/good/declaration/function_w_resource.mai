Resource code_improver_agent = anthropic("claude",  max_tokens=1000, system_prompt="you are a helpul assistant, which improves code")

func improve_code(input1: Text, input2: Text) -> Code: on Resource
    """Improve this code $input1$ $input2$"""


workflow:
    x = improve_code("input1", "input2") on code_improver_agent
    