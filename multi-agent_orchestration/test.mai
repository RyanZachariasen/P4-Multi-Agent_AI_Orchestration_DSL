Resource code_improver = gemini("gemini-2.5-flash", max_tokens=10000, system_prompt="You are a helpful assistant which improves source code. Return the code in one long file. No markdown fences. No Comments.")
Resource code_reviewer = gemini("gemini-3.1-flash-lite", max_tokens=10000, system_prompt="You are uncle bob and have to review code")
Resource evaluator = openai("gpt-4o", system_prompt="You are a strict evaluator. Respond ONLY with 'True' or 'False'.")

Type car = {wheels: int, brand: Text}

func is_perfect(code: Text) -> Bool:
    on Resource
    """Is this code completely bug-free and production ready? Respond only with True or False.
    $code$"""

func has_minor_bugs(code: Text) -> Bool:
    on Resource
    """Does this code have only minor bugs that are easy to fix? Respond only with True or False.
    $code$"""

func needs_rewrite(code: Text) -> Bool:
    on Resource
    """Is this code so bad it needs a complete rewrite? Respond only with True or False.
    $code$"""

func review_code(code: Text) -> Text:
    on Resource
    """Review this code $code$"""

func improve_code(code: Text, review: Text) -> Code:
    on Resource
    """Improve this code $code$ based on this review $review$"""

workflow:
    start_code = read_file("car_game.py")
    
    perfect = is_perfect(start_code) on evaluator
    minor_bugs = has_minor_bugs(start_code) on evaluator
    rewrite = needs_rewrite(start_code) on evaluator
    
    if perfect:
        print("Koden er perfekt! Vi udgiver den med det samme.")
        write_file("car_game_v2.py", start_code)
    else if minor_bugs:
        print("Koden har smaa fejl. Sender til Uncle Bob for et hurtigt review.")
        review = review_code(start_code) on code_reviewer
        fixed_code = improve_code(start_code, review) on code_improver
        write_file("car_game_v2.py", fixed_code)
    else if rewrite:
        print("Koden er forfaerdelig. Skriver det hele om fra bunden.")
        review = review_code(start_code) on code_reviewer
        new_code = improve_code(start_code, review) on code_improver
        write_file("car_game_v2.py", new_code)
    else:
        print("Koden er et komplet mysterium. Udskriver bare til konsollen.")
        print(start_code)